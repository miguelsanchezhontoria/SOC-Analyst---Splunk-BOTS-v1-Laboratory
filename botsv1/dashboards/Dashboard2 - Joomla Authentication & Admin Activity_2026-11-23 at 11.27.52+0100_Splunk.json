  "dataSources": {
    "ds_scgnxMk4": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=stream:http earliest=0\nuri_path=\"/joomla/administrator/index.php\"\nhttp_method=POST\n| timechart span=5m count as \"Login Attempts\""
      },
      "name": "Search_1"
    },
    "ds_h3RB7lec": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=stream:http earliest=0\nuri_path=\"/joomla/administrator/index.php\"\nhttp_method=POST\n| stats count as attempts by src_ip\n| sort - attempts"
      },
      "name": "Search_2"
    },
    "ds_o51SYD3Y": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=stream:http earliest=0\nuri_path=\"/joomla/administrator/index.php\"\nhttp_method=POST\n| rex field=form_data \"(?:^|&)username=(?<username>[^&]+)\"\n| rex field=form_data \"(?:^|&)passwd=(?<password>[^&]+)\"\n| stats count as attempts by src_ip username password\n| sort src_ip - attempts"
      },
      "name": "Search_3"
    },
    "ds_KaF2QcRT": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=stream:http earliest=0\nuri_path=\"/joomla/administrator/index.php\"\nhttp_method=POST\n| eval http_status=coalesce(status,\"No status\")\n| stats count as attempts by http_status\n| sort - attempts"
      },
      "name": "Search_4"
    },
    "ds_HanuFVCr": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=stream:http earliest=0\nuri_path=\"/joomla/administrator/index.php\"\nhttp_method=POST\nform_data=\"*install_package*\"\n| table _time src_ip status cookie form_data\n| sort - _time"
      },
      "name": "Search_5"
    },
    "ds_kp4cIY7x": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=stream:http earliest=0\nuri_path=\"/joomla/administrator/index.php\"\nhttp_method=POST\n| stats count as requests\n    dc(cookie) as distinct_cookies\n    values(status) as http_status\n    by src_ip\n| sort - requests"
      },
      "name": "Search_6"
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "latest": "$global_time.latest$",
            "earliest": "$global_time.earliest$"
          }
        }
      },
      "ds.spl2": {
        "options": {
          "queryParameters": {
            "latest": "$global_time.latest$",
            "earliest": "$global_time.earliest$"
          }
        }
      }
