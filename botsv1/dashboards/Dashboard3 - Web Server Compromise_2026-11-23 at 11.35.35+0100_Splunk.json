  "dataSources": {
    "ds_TSLwQYOv": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=suricata earliest=0\nevent_type=fileinfo\nfileinfo.filename=\"*.exe\"\n| table _time src_ip dest_ip dest_port\n    fileinfo.filename fileinfo.size\n    fileinfo.state fileinfo.stored\n| sort - _time"
      },
      "name": "Search_1"
    },
    "ds_NMvtbxKI": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=XmlWinEventLog earliest=0\nEventCode=1\nImage=\"*\\\\inetpub\\\\wwwroot\\\\*\"\n| table _time host Image CommandLine\n    ParentImage ProcessId ProcessGuid User\n| sort - _time"
      },
      "name": "Search_2"
    },
    "ds_TLrEzmEp": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=XmlWinEventLog earliest=0\nEventCode=1\nhost=\"we1149srv\"\n| timechart span=15m count as \"Process Creations\""
      },
      "name": "Search_3"
    },
    "ds_pGhvpZjh": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=XmlWinEventLog earliest=0\nEventCode=3\nhost=\"we1149srv\"\n| table _time Image ProcessId ProcessGuid\n    Protocol Initiated SourceIp SourcePort\n    DestinationIp DestinationPort DestinationHostname\n| sort - _time"
      },
      "name": "Search_4"
    },
    "ds_mabzzPZ5": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=XmlWinEventLog earliest=0\nEventCode=7\nhost=\"we1149srv\"\n| table _time Image ImageLoaded\n    ProcessId ProcessGuid Hashes Signed Signature\n| sort - _time"
      },
      "name": "Search_5"
    },
    "ds_WGZPdbif": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=XmlWinEventLog earliest=0\nhost=\"we1149srv\"\n| stats count as events by EventCode\n| sort EventCode"
      },
      "name": "Search_6"
    }
  },
