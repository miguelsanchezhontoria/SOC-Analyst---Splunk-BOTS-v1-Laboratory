  "dataSources": {
    "ds_LbzUFfXo": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=stream:http earliest=0\nimreallynotbatman.com\n| timechart span=15m count as \"HTTP Requests\""
      },
      "name": "Search_1"
    },
    "ds_mNEtmVqa": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=stream:http earliest=0\nimreallynotbatman.com\n| stats count as requests by src_ip\n| sort - requests\n| head 10"
      },
      "name": "Search_2"
    },
    "ds_E9zGQLkI": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=stream:http earliest=0\nimreallynotbatman.com\n| stats count as requests by uri_path\n| sort - requests\n| head 10"
      },
      "name": "Search_3"
    },
    "ds_222aADn8": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=stream:http earliest=0\nimreallynotbatman.com\n| eval http_status=coalesce(status,\"No status\")\n| stats count as requests by http_status\n| sort - requests"
      },
      "name": "Search_4"
    },
    "ds_1mCngmNv": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=suricata earliest=0\nimreallynotbatman.com\n| stats count as events by signature\n| sort - events\n| head 10"
      },
      "name": "Search_5"
    },
    "ds_m7mnLEUC": {
      "type": "ds.search",
      "options": {
        "query": "index=botsv1 sourcetype=stream:http earliest=0\nimreallynotbatman.com\n| stats count as requests\n    dc(uri_path) as unique_paths\n    values(http_method) as methods\n    values(status) as status_codes\n    by src_ip\n| sort - requests"
      },
      "name": "Search_6"
    }
  },
